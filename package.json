{
  "name": "dsh-file-attach",
  "version": "0.1.0",
  "description": "Drag-and-drop PDF, Office, images, and text/code files into DSH conversations. The host extracts (and OCRs) them into the prompt; attach_* tools cover notebook cells, PDF-page OCR, image describe, and save.",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek",
    "cordis",
    "file-attachment",
    "document-extraction",
    "ocr",
    "ai"
  ],
  "homepage": "https://github.com/lucadxingg/unified-file-reader#readme",
  "bugs": {
    "url": "https://github.com/lucadxingg/unified-file-reader/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucadxingg/unified-file-reader.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "docs/assets/cover.jpg"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@napi-rs/canvas": "^1.0.7",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.1",
    "pdfjs-dist": "^6.2.108",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.8.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "license": "MIT"
}
